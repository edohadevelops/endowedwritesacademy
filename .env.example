# ---------------------------------------------------------------------------
# Endowed Academy environment variables. See MIGRATION.md for where each goes.
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Browser-safe: bundled into the site, visible to anyone -----------------
# Supabase → Project Settings → API Keys. Use the PUBLISHABLE key
# (sb_publishable_…) or, on older projects, the legacy "anon" key.
# Leave both empty to run the in-browser preview mode instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Netlify only (Site configuration → Environment variables) -------------
# The public address, used for canonical links, the sitemap and link previews.
# Give it the "Functions" scope so the edge functions can read it.
SITE_URL=https://www.example.com

# --- Supabase Edge Function secrets (set with `supabase secrets set`) -------
# These are NOT Netlify variables and must never start with VITE_.
# COMMENT_IP_SALT=<long random string>        # openssl rand -hex 32
# ALLOWED_ORIGINS=https://www.example.com,https://your-site.netlify.app
#
# The secret / service_role key is given to Edge Functions by Supabase
# automatically. Never put it in this file, in Netlify, or in code.
